# ---- Chain ----
# 1 turns chain reads on. Off (default): every chain read returns nothing and no request is sent.
CHAIN_READS=0
# Server-side only (never NEXT_PUBLIC_). May carry an API key: it is never logged or sent to the browser.
# Chain id 4663 is checked on every read.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Several endpoints share the load (each is checked for chain 4663 before use). Free, keyless, tested
# 2026-11-13: the official RPC (getLogs up to 30k blocks) and dRPC's public node (getLogs up to 10k).
# "#logs=N" sets an endpoint's eth_getLogs window. A paid endpoint with a key goes here too.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood.drpc.org#logs=10000
# Lanes per endpoint; per lane: requests in flight and the minimum gap between them
RPC_LANES=4
RPC_CONCURRENCY=4
RPC_SPACING_MS=60

# ---- Index ----
# Optional path of the SQLite index (default: <repo>/data/corbel.db)
CORBEL_DB=
CORBEL_BACKFILL_DAYS=7
