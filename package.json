{
  "name": "corbel",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@corbel/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @corbel/web e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.1",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
